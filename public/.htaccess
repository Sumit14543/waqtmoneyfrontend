# ============================================================================
# Waqt Money Production Apache .htaccess (SEO, Security & CWV Optimized)
# ============================================================================

# Disable Directory Indexing
Options -Indexes

DirectoryIndex index.html

# 0. Anti-DDoS, Vulnerability Scanner & Sensitive File Protection Rules
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block Grafana k6, Scanners & Automated Load-Testing Bot User Agents
  RewriteCond %{HTTP_USER_AGENT} (k6|grafana|go-http-client|jmeter|ab|locust|sqlmap|nikto|nmap|masscan) [NC]
  RewriteRule ^ - [F,L]

  # Block WordPress / CMS Vulnerability Scanners (Since site is custom React + Node.js)
  RewriteCond %{REQUEST_URI} ^/(wp-|wp/|wordpress/|wp-admin|wp-config|wp-content|wp-json|wp-login|webmin|wrangler\.toml|vercel\.json|web\.config) [NC]
  RewriteRule ^ - [F,L]

  # Block Direct Probing of Sensitive Files (.env, .git, config files, settings.json, logs)
  RewriteCond %{REQUEST_URI} \.(env|git|htaccess|htpasswd|yml|yaml|json|log|bak|config|ts|sql|ini)$ [NC,OR]
  RewriteCond %{REQUEST_URI} (%2e|\.)(env|git|config) [NC]
  RewriteRule ^ - [F,L]
</IfModule>

# Block Specific Attacker / Scanner Subnets & IPs
<IfModule mod_authz_core.c>
  <RequireAll>
    Require all granted
    Require not ip 122.160.166.184
    Require not ip 185.177.72.0/24
    Require not ip 178.16.54.184
    Require not ip 128.90.135.8
    Require not ip 165.22.128.137
  </RequireAll>
</IfModule>

# 1. GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml image/x-icon font/ttf font/otf font/woff font/woff2
</IfModule>

# 2. Brotli Compression
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml font/woff2
</IfModule>

# 3. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 4. Security & Headers
<IfModule mod_headers.c>
  # Static Cache (Hashed assets immutable)
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML No Cache
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Security Headers
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Allow camera, microphone, and geolocation for Video KYC
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(self)"
</IfModule>

# 5. MIME Types
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
</IfModule>

# 6. Rewrite Engine & SEO Canonicalization
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS + non-www in a SINGLE 301 hop
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.waqtmoney\.com$ [NC]
  RewriteRule ^(.*)$ https://waqtmoney.com/$1 [L,R=301]

  # Strip trailing slashes on inner routes (except directories)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [L,R=301]

  # Server-side 301 Redirects for Legacy Root Loan URLs -> Canonical /loans/*
  RewriteRule ^personal-loan/?$ https://waqtmoney.com/loans/personal-loan [L,R=301]
  RewriteRule ^business-loan/?$ https://waqtmoney.com/loans/business-loan [L,R=301]
  RewriteRule ^(payday-loan|pay-day-loan)/?$ https://waqtmoney.com/loans/payday-loan [L,R=301]
  RewriteRule ^(short-term-loan|short-term-loans)/?$ https://waqtmoney.com/loans/short-term-loan [L,R=301]
  RewriteRule ^vehicle-loan/?$ https://waqtmoney.com/loans/vehicle-loan [L,R=301]
  RewriteRule ^loan-against-property/?$ https://waqtmoney.com/loans/loan-against-property [L,R=301]
  RewriteRule ^medical-loan/?$ https://waqtmoney.com/loans/medical-loan [L,R=301]
  RewriteRule ^education-loan/?$ https://waqtmoney.com/loans/education-loan [L,R=301]
  RewriteRule ^loans/?$ https://waqtmoney.com/services [L,R=301]

  # Canonical 301 Redirects for Case Variations & Legacy routes
  RewriteRule ^Faqs/?$ https://waqtmoney.com/faqs [L,R=301]
  RewriteRule ^Emi-Calculator/?$ https://waqtmoney.com/emi-calculator [L,R=301]
  RewriteRule ^Repayment/?$ https://waqtmoney.com/repayment [L,R=301]
  RewriteRule ^Policies/?$ https://waqtmoney.com/policies [L,R=301]
  RewriteRule ^Contact/?$ https://waqtmoney.com/contact [L,R=301]
  RewriteRule ^(Privacy-Policies|privacy-policies)/?$ https://waqtmoney.com/privacy-policy [L,R=301]
  RewriteRule ^blogs/?$ https://waqtmoney.com/blog [L,R=301]
  RewriteRule ^blogs/(.*)$ https://waqtmoney.com/blog/$1 [L,R=301]

  # Serve existing physical static files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve pre-rendered HTML snapshot if directory/index.html exists
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # React SPA Routing Fallback (for valid client routes)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

ErrorDocument 404 /index.html
