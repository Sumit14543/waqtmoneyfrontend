# ====================================================================
# WAQT MONEY PRODUCTION .HTACCESS FOR CPANEL / APACHE
# High-Performance Compression, Caching, Security & SPA Routing
# ====================================================================

# Disable Directory Indexing
Options -Indexes

DirectoryIndex index.html

# 0. Anti-DDoS, Vulnerability Scanner & Sensitive File Protection Rules
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block Grafana k6, Scanners & Automated Load-Testing Bot User Agents
  RewriteCond %{HTTP_USER_AGENT} (k6|grafana|go-http-client|jmeter|ab|locust|sqlmap|nikto|nmap|masscan) [NC]
  RewriteRule ^ - [F,L]

  # Block Direct Probing of Sensitive Files (.env, .git, config files, settings.json, logs)
  RewriteCond %{REQUEST_URI} \.(env|git|htaccess|htpasswd|yml|yaml|json|log|bak|config|ts|sql|ini)$ [NC,OR]
  RewriteCond %{REQUEST_URI} (%2e|\.)(env|git|config) [NC]
  RewriteRule ^ - [F,L]
</IfModule>

# Block Specific Attacker / Scanner Subnets & IPs
<IfModule mod_authz_core.c>
  <RequireAll>
    Require all granted
    Require not ip 122.160.166.184
    Require not ip 185.177.72.0/24
  </RequireAll>
</IfModule>

# 1. GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml image/x-icon font/ttf font/otf font/woff font/woff2
</IfModule>

# 2. Brotli Compression
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml font/woff2
</IfModule>

# 3. Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 4. Security & Headers
<IfModule mod_headers.c>
  # Static Cache
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML No Cache
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Remove restrictive server geolocation=() policy and allow geolocation
  Header always unset Permissions-Policy
  Header unset Permissions-Policy
  Header always set Permissions-Policy "geolocation=*, camera=*, microphone=*"
  Header set Permissions-Policy "geolocation=*, camera=*, microphone=*"
</IfModule>

# 5. React SPA Routing, Non-WWW Redirect & Force HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force Non-WWW (Redirect www.waqtmoney.com to waqtmoney.com)
  RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2. Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://waqtmoney.com%{REQUEST_URI} [R=301,L]

  # 3. Canonical 301 Redirects for Duplicate Loan URLs
  RewriteRule ^personal-loan/?$ https://waqtmoney.com/loans/personal-loan [R=301,L]
  RewriteRule ^business-loan/?$ https://waqtmoney.com/loans/business-loan [R=301,L]
  RewriteRule ^payday-loan/?$ https://waqtmoney.com/loans/payday-loan [R=301,L]
  RewriteRule ^pay-day-loan/?$ https://waqtmoney.com/loans/payday-loan [R=301,L]
  RewriteRule ^loan-against-property/?$ https://waqtmoney.com/loans/loan-against-property [R=301,L]
  RewriteRule ^vehicle-loan/?$ https://waqtmoney.com/loans/vehicle-loan [R=301,L]
  RewriteRule ^short-term-loan/?$ https://waqtmoney.com/loans/short-term-loan [R=301,L]
  RewriteRule ^short-term-loans/?$ https://waqtmoney.com/loans/short-term-loan [R=301,L]
  RewriteRule ^medical-loan/?$ https://waqtmoney.com/loans/medical-loan [R=301,L]
  RewriteRule ^education-loan/?$ https://waqtmoney.com/loans/education-loan [R=301,L]

  # 4. Canonical 301 Redirects for Case Variations & Legal Pages
  RewriteRule ^Faqs/?$ https://waqtmoney.com/faqs [R=301,L]
  RewriteRule ^Emi-Calculator/?$ https://waqtmoney.com/emi-calculator [R=301,L]
  RewriteRule ^Repayment/?$ https://waqtmoney.com/repayment [R=301,L]
  RewriteRule ^Policies/?$ https://waqtmoney.com/policies [R=301,L]
  RewriteRule ^Contact/?$ https://waqtmoney.com/contact [R=301,L]
  RewriteRule ^Privacy-Policies/?$ https://waqtmoney.com/privacy-policy [R=301,L]
  RewriteRule ^privacy-policies/?$ https://waqtmoney.com/privacy-policy [R=301,L]
  RewriteRule ^blogs/?$ https://waqtmoney.com/blog [R=301,L]
  RewriteRule ^blogs/(.*)$ https://waqtmoney.com/blog/$1 [R=301,L]

  # Serve existing physical static files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Fallback directories without an index.html to main index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ index.html [L]

  # React Router fallback to index.html
  RewriteRule ^ index.html [L]
</IfModule>

ErrorDocument 404 /index.html

